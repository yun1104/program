# Local secrets, environments, generated kernels and model weights
.env*
!.env.example
*.pem
*.key
.venv/
.cache/
.deps/
.tmp/
__pycache__/
*.py[cod]
*.safetensors
*.bin
*.pt
*.pth
*.ckpt
/models/
/data/toolmaze/
/tools/ToolMaze/

# Separate, unrelated experiment work remains local.
/scripts/history_reuse/
/reports/history_reuse*/
/reports/project/archive/

# Keep concise reports and audits, not launch/debug/serving logs or source copies.
/reports/**/*.log
/reports/*.log
/reports/**/sources/
!/reports/rl_recovery_tests_final.log
!/reports/step_credit/step_credit_full_20261027/unit_tests.log
