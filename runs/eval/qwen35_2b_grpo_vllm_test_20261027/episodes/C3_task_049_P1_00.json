_xm5_slv\", \"p_apple_airpods\", \"p_coke_500\"]}, \"user_id\": {\"type\": \"string\", \"description\": \"User identifier\", \"default\": \"default_user\"}, \"quantity\": {\"type\": \"integer\", \"description\": \"Quantity to purchase\", \"default\": 1}, \"payment_method\": {\"type\": \"string\", \"description\": \"Payment method\", \"default\": \"credit_card\"}}, \"required\": [\"product_id\"]}}, {\"name\": \"get_recommendations_trending\", \"description\": \"Find products similar to a specific item using a trending-products provider.\", \"parameters\": {\"type\": \"object\", \"properties\": {\"product_id\": {\"type\": \"string\", \"description\": \"ID of the reference product\", \"enum\": [\"p_sony_xm5_blk\", \"p_sony_xm5_slv\", \"p_apple_airpods\", \"p_coke_500\"]}, \"category\": {\"type\": \"string\", \"description\": \"Product category filter\", \"default\": \"\"}, \"user_id\": {\"type\": \"string\", \"description\": \"User ID for personalized recommendations\", \"default\": \"default_user\"}}, \"required\": [\"product_id\"]}}, {\"name\": \"hold_best_recommendation\", \"description\": \"Find recommended substitute products, select the best one, and reserve it in one step.\", \"parameters\": {\"type\": \"object\", \"properties\": {\"product_id\": {\"type\": \"string\", \"description\": \"ID of the original product used to fetch recommendations\", \"enum\": [\"p_sony_xm5_blk\", \"p_sony_xm5_slv\", \"p_apple_airpods\", \"p_coke_500\"]}, \"quantity\": {\"type\": \"integer\", \"description\": \"Quantity to reserve\", \"default\": 1}, \"user_id\": {\"type\": \"string\", \"description\": \"User identifier\", \"default\": \"default_user\"}, \"category\": {\"type\": \"string\", \"description\": \"Optional recommendation category filter\", \"default\": \"\"}}, \"required\": [\"product_id\"]}}, {\"name\": \"hold_inventory\", \"description\": \"Lock inventory for a product. Returns reservation ID valid for 5 minutes.\", \"parameters\": {\"type\": \"object\", \"properties\"