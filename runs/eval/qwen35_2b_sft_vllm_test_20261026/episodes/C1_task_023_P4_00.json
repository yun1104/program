      "role": "user",
      "content": "Available tools:\n[{\"name\": \"apply_light_brightness\", \"description\": \"Apply a normalized light-brightness request and return device_id-oriented output.\", \"parameters\": {\"type\": \"object\", \"properties\": {\"light_id\": {\"type\": \"string\", \"description\": \"Target light ID\", \"enum\": [\"light_living\", \"light_bedroom\"]}, \"brightness\": {\"type\": \"integer\", \"description\": \"Brightness level to set\"}}, \"required\": [\"light_id\", \"brightness\"]}}, {\"name\": \"build_light_brightness_request\", \"description\": \"Build a brightness-only request for downstream light-brightness actions.\", \"parameters\": {\"type\": \"object\", \"properties\": {\"light_status\": {\"type\": \"object\", \"description\": \"Light status object from get_light_status\"}, \"brightness\": {\"type\": \"integer\", \"description\": \"Target brightness level\"}}, \"required\": [\"light_status\", \"brightness\"]}}, {\"name\": \"cancel_reservation\", \"description\": \"Cancel an existing travel booking (flight or hotel)\", \"parameters\": {\"type\": \"object\", \"properties\": {\"booking_id\": {\"type\": \"string\", \"description\": \"Booking ID to cancel\"}, \"reason\": {\"type\": \"string\", \"description\": \"Cancellation reason (optional)\", \"default\": \"\"}}, \"required\": [\"booking_id\"]}}, {\"name\": \"get_light_status\", \"description\": \"Get the current state (on/off, brightness, color) of a specific smart light using the SmartLight API. More efficient for lights than generic status check.\", \"parameters\": {\"type\": \"object\", \"properties\": {\"light_id\": {\"type\": \"string\", \"description\": \"The ID of the light device (e.g., light_living)\", \"enum\": [\"light_living\", \"light_bedroom\"]}}, \"required\": [\"light_id\"]}}, {\"name\": \"snapshot_workspace\", \"description\": \"Create a backup of specified workspace\", \"parameters\": {\"type\": \"object\", \"properties\": {\"workspace_path\": {\"type\": \"string\", \"description\": 