"type\": \"string\", \"description\": \"Notification channel\", \"enum\": [\"app\", \"sms\", \"email\"], \"default\": \"app\"}}, \"required\": [\"user_id\", \"target_currency\"]}}, {\"name\": \"create_document_and_alert\", \"description\": \"Save a document and notify a target user about it.\", \"parameters\": {\"type\": \"object\", \"properties\": {\"title\": {\"type\": \"string\", \"description\": \"Note title\", \"default\": \"Untitled\"}, \"content\": {\"type\": \"string\", \"description\": \"Note content\"}, \"tags\": {\"type\": \"array\", \"items\": {\"type\": \"string\"}, \"description\": \"List of tags\", \"default\": []}, \"user_id\": {\"type\": \"string\", \"description\": \"User identifier to notify\", \"default\": \"default_user\"}, \"priority\": {\"type\": \"string\", \"description\": \"Notification priority\", \"enum\": [\"low\", \"medium\", \"high\"], \"default\": \"medium\"}, \"channel\": {\"type\": \"string\", \"description\": \"Notification channel\", \"enum\": [\"app\", \"sms\", \"email\"], \"default\": \"app\"}}, \"required\": [\"content\"]}}, {\"name\": \"get_account_balance_bank_api\", \"description\": \"Retrieve current available balance from a banking system provider.\", \"parameters\": {\"type\": \"object\", \"properties\": {\"user_id\": {\"type\": \"string\", \"description\": \"Unique user identifier (e.g., 'user_01')\"}, \"account_type\": {\"type\": \"string\", \"description\": \"Type of account\", \"enum\": [\"checking\", \"savings\", \"investment\"], \"default\": \"investment\"}}, \"required\": [\"user_id\"]}}, {\"name\": \"get_exchange_rate_fixer\", \"description\": \"Get exchange rate using Fixer.io API, data sourced from European Central Bank\", \"parameters\": {\"type\": \"object\", \"properties\": {\"from_currency\": {\"type\": \"string\", \"description\": \"Source currency code, e.g.: USD, EUR, JPY\", \"enum\": [\"USD\", \"EUR\", \"JPY\", \"GBP\", \"CNY\"]}, \"to_currency\": {\"type\": \"string\", \"description\": \"Target currency code, e.g.: USD, EUR, JPY\", \"enum\": [\"USD\", \"EUR\", \"JPY\", \"GBP\", \"CNY\"]}, \"from\": {\"type\": \"string\", \"description\": \"Alias for from_currency\"}, \"to\": {\"type\": \"string\", \"description\": \"Alias for to_currency\"}}, \"required\": [\"from_currency\", \"to_currency\"]}}, {\"name\": \"get_market_status_polygon\", \"description\": \"Check if a major stock exchange is open using a Polygon-style provider.\", \"parameters\": {\"type\": \"object\", \"properties\": {\"exchange\": {\"type\": \"string\", \"description\": \"Exchange code (e.g., 'NYSE', 'NASDAQ', 'LSE', 'HKEX', 'CRYPTO')\", \"enum\": [\"NYSE\", \"NASDAQ\", \"LSE\", \"HKEX\", \"CRYPTO\"]}}, \"required\": [\"exchange\"]}}, {\"name\": \"get_news_gnews\", \"description\": \"Get latest news headlines using GNews API, powered by Google News with good real-time performance\", \"parameters\": {\"type\": \"object\", \"properties\": {\"category\": {\"type\": \"string\", \"description\": \"News category, e.g.: technology, business, sports, health\", \"enum\": [\"technology\", \"business\", \"sports\", \"health\"]}}, \"required\": [\"category\"]}}, {\"name\": \"place_equity_order_from_cost\", \"description\": \"Place a checked buy order from a cost-estimated equity order context.\", \"parameters\": {\"type\": \"object\", \"properties\": {\"amount\": {\"type\": \"number\", \"description\": \"Total cost amount to pass into checked execution\"}, \"ticker\": {\"type\": \"string\", \"description\": \"Equity ticker\"}}, \"required\": [\"amount\", \"ticker\"]}}, {\"name\": \"snapshot_workspace\", \"description\": \"Create a backup of specified workspace\", \"parameters\": {\"type\": \"object\", \"properties\": {\"workspace_path\": {\"type\": \"string\", \"description\": \"Workspace path to backup\"}, \"backup_name\": {\"type\": \"string\", \"description\": \"Backup name\", \"default\": \"\"}}, \"required\": [\"workspace_path\"]}}]\n\nUser request:\nPlease check whether the NASDAQ market is open, then p