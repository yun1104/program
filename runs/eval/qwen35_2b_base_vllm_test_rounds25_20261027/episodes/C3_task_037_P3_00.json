me\"}, \"check_in_date\": {\"type\": \"string\", \"description\": \"Check-in date, format: YYYY-MM-DD\", \"default\": \"2026-01-01\"}, \"check_out_date\": {\"type\": \"string\", \"description\": \"Check-out date, format: YYYY-MM-DD\", \"default\": \"2026-01-03\"}, \"guest_name\": {\"type\": \"string\", \"description\": \"Guest full name\", \"default\": \"guest_01\"}, \"room_type\": {\"type\": \"string\", \"description\": \"Room type: standard, deluxe, suite (default: standard)\", \"enum\": [\"standard\", \"deluxe\", \"suite\"], \"default\": \"standard\"}}, \"required\": [\"hotel_name\", \"check_in_date\", \"guest_name\"]}}, {\"name\": \"get_bank_balance_sheet_native\", \"description\": \"Retrieve a bank-native balance sheet including sheet id, owner id, balance amount, and denomination.\", \"parameters\": {\"type\": \"object\", \"properties\": {\"user_id\": {\"type\": \"string\", \"description\": \"User identifier\", \"default\": \"default_user\"}, \"account_type\": {\"type\": \"string\", \"description\": \"Account type\", \"enum\": [\"checking\", \"savings\", \"investment\"], \"default\": \"checking\"}}, \"required\": [\"user_id\"]}}, {\"name\": \"get_broker_balance_ledger_native\", \"description\": \"Retrieve a broker-native balance ledger including ledger reference, principal id, equity value, and currency code.\", \"parameters\": {\"type\": \"object\", \"properties\": {\"user_id\": {\"type\": \"string\", \"description\": \"User identifier\", \"default\": \"default_user\"}, \"account_type\": {\"type\": \"string\", \"description\": \"Account type\", \"enum\": [\"checking\", \"savings\", \"investment\"], \"default\": \"investment\"}}, \"required\": [\"user_id\"]}}, {\"name\": \"get_contact_info_directory\", \"description\": \"Search for a contact's email, phone, and department using a directory provider.\", \"parameters\": {\"type\": \"object\", \"properties\": {\"name\": {\"type\": \"string\", \"description\": \"Name of the contact to search\", \"enum\": [\"alice\