"type\": \"string\", \"description\": \"Notification channel\", \"enum\": [\"app\", \"sms\", \"email\"], \"default\": \"app\"}}, \"required\": [\"user_id\", \"target_currency\"]}}, {\"name\": \"create_document_and_alert\", \"description\": \"Save a document and notify a target user about it.\", \"parameters\": {\"type\": \"object\", \"properties\": {\"title\": {\"type\": \"string\", \"description\": \"Note title\", \"default\": \"Untitled\"}, \"content\": {\"type\": \"string\", \"description\": \"Note content\"}, \"tags\": {\"type\": \"array\", \"items\": {\"type\": \"string\"}, \"description\": \"List of tags\", \"default\": []}, \"user_id\": {\"type\": \"string\", \"description\": \"User identifier to notify\", \"default\": \"default_user\"}, \"priority\": {\"type\": \"string\", \"description\": \"Notification priority\", \"enum\": [\"low\", \"medium\", \"high\"], \"default\": \"medium\"}, \"channel\": {\"type\": \"string\", \"description\": \"Notification channel\", \"enum\": [\"app\", \"sms\", \"email\"], \"default\": \"app\"}}, \"required\": [\"content\"]}}, {\"name\": \"get_account_balance_bank_api\", \"description\": \"Retrieve current available balance from a banking system provider.\", \"parameters\": {\"type\": \"object\", \"properties\": {\"user_id\": {\"type\": \"string\", \"description\": \"Unique user identifier (e.g., 'user_01')\"}, \"account_type\": {\"type\": \"string\", \"description\": \"Type of account\", \"enum\": [\"checking\", \"savings\", \"investment\"], \"default\": \"investment\"}}, \"required\": [\"user_id\"]}}, {\"name\": \"get_exchange_rate_fixer\", \"description\": \"Get exchange rate using Fixer.io API, data sourced from European Central Bank\", \"parameters\": {\"type\": \"object\", \"properties\": {\"from_currency\": {\"type\": \"string\", \"description\": \"Source currency code, e.g.: USD, EUR, JPY\", \"enum\": [\"USD\", \"EUR\", \"JPY\", \"GBP\", \"CNY\"]}, \"to_currency\": {\"type\": \"string\", \"description\": \"Target currency