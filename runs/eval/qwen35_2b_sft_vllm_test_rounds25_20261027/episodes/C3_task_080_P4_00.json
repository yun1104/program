      "content": "Available tools:\n[{\"name\": \"apply_lock_state\", \"description\": \"Apply a normalized smart-lock control request and return aligned output fields.\", \"parameters\": {\"type\": \"object\", \"properties\": {\"lock_id\": {\"type\": \"string\", \"description\": \"Target lock ID\", \"enum\": [\"lock_main\", \"lock_bedroom\"]}, \"state\": {\"type\": \"string\", \"description\": \"Lock state to set\", \"enum\": [\"lock\", \"unlock\"]}, \"pin_code\": {\"type\": \"string\", \"description\": \"PIN code for authentication\", \"default\": \"2026\"}}, \"required\": [\"lock_id\", \"state\"]}}, {\"name\": \"discover_smart_devices\", \"description\": \"Discover and list all available IoT devices in a specified room or location using the SmartHome Discovery Protocol. Essential for finding device IDs.\", \"parameters\": {\"type\": \"object\", \"properties\": {\"location\": {\"type\": \"string\", \"description\": \"Target location to scan, e.g.: 'living_room', 'bedroom'\", \"enum\": [\"living_room\", \"bedroom\"]}}, \"required\": [\"location\"]}}, {\"name\": \"get_light_bridge_payload_native\", \"description\": \"Retrieve a bridge-native light payload including bridge light id, bridge state, dimmer, and tone.\", \"parameters\": {\"type\": \"object\", \"properties\": {\"device_id\": {\"type\": \"string\", \"description\": \"Smart-light identifier\", \"enum\": [\"light_living\", \"light_bedroom\"]}}, \"required\": [\"device_id\"]}}, {\"name\": \"get_light_mesh_snapshot_native\", \"description\": \"Retrieve a mesh-native light snapshot including mesh node, lamp state, level percentage, and hue name.\", \"parameters\": {\"type\": \"object\", \"properties\": {\"light_id\": {\"type\": \"string\", \"description\": \"Smart-light identifier\", \"enum\": [\"light_living\", \"light_bedroom\"]}}, \"required\": [\"light_id\"]}}, {\"name\": \"get_light_status\", \"description\": \"Get the current state (on/off, brightness, color) of a specific smart light using the SmartLight