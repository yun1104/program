ent_amount\": {\"type\": \"number\", \"description\": \"Amount to invoice\"}, \"user_id\": {\"type\": \"string\", \"description\": \"User identifier\"}, \"email\": {\"type\": \"string\", \"description\": \"Invoice email\"}, \"payment_gateway\": {\"type\": \"string\", \"description\": \"Payment gateway\"}, \"reservation_id\": {\"type\": \"string\", \"description\": \"Reservation identifier\", \"default\": \"\"}}, \"required\": [\"items\", \"payment_amount\", \"user_id\", \"email\", \"payment_gateway\"]}}, {\"name\": \"hold_best_recommendation\", \"description\": \"Find recommended substitute products, select the best one, and reserve it in one step.\", \"parameters\": {\"type\": \"object\", \"properties\": {\"product_id\": {\"type\": \"string\", \"description\": \"ID of the original product used to fetch recommendations\", \"enum\": [\"p_sony_xm5_blk\", \"p_sony_xm5_slv\", \"p_apple_airpods\", \"p_coke_500\"]}, \"quantity\": {\"type\": \"integer\", \"description\": \"Quantity to reserve\", \"default\": 1}, \"user_id\": {\"type\": \"string\", \"description\": \"User identifier\", \"default\": \"default_user\"}, \"category\": {\"type\": \"string\", \"description\": \"Optional recommendation category filter\", \"default\": \"\"}}, \"required\": [\"product_id\"]}}, {\"name\": \"submit_order_from_summary\", \"description\": \"Submit an order from a precomputed cart summary payload.\", \"parameters\": {\"type\": \"object\", \"properties\": {\"items\": {\"type\": \"array\", \"description\": \"Cart items\", \"items\": {\"type\": \"object\"}}, \"payment_amount\": {\"type\": \"number\", \"description\": \"Amount to charge\"}, \"user_id\": {\"type\": \"string\", \"description\": \"User identifier\"}, \"payment_method\": {\"type\": \"string\", \"description\": \"Payment method\"}, \"subtotal\": {\"type\": \"number\", \"description\": \"Cart subtotal\", \"default\": 0}, \"discount\": {\"type\": \"number\", \"description\": \"Cart discount\", \"default\": 0}, \"coupon_status\": {\